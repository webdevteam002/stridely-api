NODE_ENV=staging
PORT=3000
APP_NAME=stridely-api
APP_VERSION=0.1.0
API_PREFIX=api/v1
LOG_LEVEL=info
CORS_ORIGINS=https://staging.stridely.app,https://app.staging.stridely.app
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=replace-with-staging-secret-min-32-chars!!
JWT_ISSUER=stridely-api
JWT_AUDIENCE=stridely-app
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=60
TRUST_PROXY=true
SKIP_DB_CONNECT=false
