NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME=stridely-api
APP_VERSION=0.1.0
API_PREFIX=api/v1
LOG_LEVEL=info
# Explicit allow-list required in production (* is rejected at boot)
CORS_ORIGINS=https://stridely.app,https://app.stridely.app
SWAGGER_ENABLED=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
JWT_SECRET=replace-with-production-secret-min-32-chars!
JWT_ISSUER=stridely-api
JWT_AUDIENCE=stridely-app
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=60
TRUST_PROXY=true
SKIP_DB_CONNECT=false
GOOGLE_CLIENT_ID=
