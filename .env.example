# Stridely API — copy to .env and fill credentials
# Loads: .env.${NODE_ENV} then .env (see AppConfigModule)

NODE_ENV=development
PORT=3000
APP_NAME=stridely-api
APP_VERSION=0.1.0
API_PREFIX=api/v1
LOG_LEVEL=info

# Dev may use *; staging/production MUST be an explicit comma-separated allow-list
CORS_ORIGINS=*

# Defaults: on in development/test, off in staging/production
SWAGGER_ENABLED=true

# Bind address (Render / Docker: 0.0.0.0; optional override)
# HOST=0.0.0.0

# PostgreSQL (Supabase / Neon / etc.) — keep SSL on for cloud
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Auth (production JWT_SECRET >= 32 chars required)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32
JWT_ISSUER=stridely-api
JWT_AUDIENCE=stridely-app
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_CLOCK_SKEW_SECONDS=60

# Google Sign-In — Web OAuth client ID (audience for ID token verify)
GOOGLE_CLIENT_ID=

# Global rate limit (ThrottlerGuard)
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=60

# Behind reverse proxy / load balancer
TRUST_PROXY=false

# Local boot without DB (never true in production)
SKIP_DB_CONNECT=false
